const axios = require('axios');

const BASE_URL = 'https://openlibrary.org';

// Retrieve books by author, title, or ISBN
async function getBooks({ author, title, isbn }) {
    try {
        const params = {};

        if (author) params.author = author;
        if (title) params.title = title;
        if (isbn) params.isbn = isbn;

        const response = await axios.get(`${BASE_URL}/search.json`, {
            params: params
        });

        const books = response.data.docs;

        if (books.length === 0) {
            console.log('No books found.');
            return [];
        }

        const bookDetails = books.map(book => ({
            title: book.title,
            author: book.author_name || [],
            first_publish_year: book.first_publish_year || 'Unknown',
            isbn: book.isbn ? book.isbn[0] : 'Not available',
            publisher: book.publisher ? book.publisher[0] : 'Unknown',
            edition_count: book.edition_count,
            key: book.key
        }));

        console.log(bookDetails);
        return bookDetails;

    } catch (error) {
        console.error('Error retrieving books:', error.message);
        return [];
    }
}

// Example usage
getBooks({
    author: 'J.K. Rowling',
    title: 'Harry Potter',
    isbn: ''
});
